# Copy this file to .env and fill in real values.
# The app runs with local fallbacks for anything left blank,
# EXCEPT Azure OpenAI, which is required for field extraction.

ENV=poc

# --- Pipeline behaviour ---
USE_LOCAL_PDF_FILE=true     # read PDFs from data_uploads/ instead of Blob Storage
USE_CACHE=true              # skip OCR/LLM calls if cached output already exists
PAGES_PER_CHUNK=2
NOTIFY_ON_COMPLETE=false    # set true + fill in NOTIFY_RECIPIENT to email on success
NOTIFY_RECIPIENT=

# --- Azure Blob Storage (optional - falls back to local disk) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_UPLOADS=automation-container
AZURE_STORAGE_CONTAINER_OUTPUT=automation-file-processed
URL_EXPIRY_HOURS=24

# --- Azure AI Document Intelligence (required for OCR) ---
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_DOCINTEL_MODEL=prebuilt-layout

# --- Azure OpenAI (required for field extraction) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- Email notifications (optional - pick one provider) ---
AZURE_EMAIL_COMMUNICATIONS_STRING=
AZURE_EMAIL_SENDER=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
