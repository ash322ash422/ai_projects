# Copy this file to .env and fill in real values.
# The app will run with local fallbacks for anything left blank,
# EXCEPT Azure OpenAI, which is required for field extraction.

ENV=poc

# --- Azure Blob Storage (optional for POC - falls back to local disk) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_UPLOADS=uploads
AZURE_STORAGE_CONTAINER_OUTPUT=output

# --- Azure AI Document Intelligence (optional for POC - falls back to pypdf) ---
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_DOCINTEL_MODEL=prebuilt-layout

# --- Azure OpenAI (required) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
